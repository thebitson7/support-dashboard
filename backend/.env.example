# Required. A long random value, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Local development only. Off (the default when unset) turns on the HTTPS
# hardening below, serves static files through whitenoise, and makes the seed
# commands refuse to run.
DEBUG=True

# Comma-separated; these are the defaults. In production include every host
# name Django is reached by, including the one in the frontend's
# DJANGO_API_URL (e.g. 127.0.0.1 when Next.js calls Django on the same box).
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------------

# Unset: the local SQLite file (backend/db.sqlite3), no server needed.
# Production: PostgreSQL. Migrations, seeds and tests work the same way.
# Query parameters become connection options, e.g. ?sslmode=require.
# DATABASE_URL=postgres://support_dashboard:change-me@localhost:5432/support_dashboard

# --- Cache (rate limits) ----------------------------------------------------------

# Unset: per-process memory, fine for one dev server. Production with more
# than one API process: a shared Redis, so every process counts the same
# sign-in attempts and exports. Once set, Redis is required: if it's
# unreachable, the rate-limited endpoints (sign-in, CSV exports,
# Administration writes) fail closed with a 503 "temporarily unavailable"
# within ~2 s, and the server log names Redis; everything else keeps working.
# `manage.py check --deploy` fails (core.E003) while it can't be reached.
# REDIS_URL=redis://localhost:6379/0

# --- Rate limits (defaults shown; "N/period", period like s, m, h, d or 5m) --------

# Sign-in attempts per username + client IP.
# LOGIN_THROTTLE_RATE=5/5m
# CSV exports per user (tickets and team activity share one budget).
# EXPORT_THROTTLE_RATE=30/h
# Administration writes (create / edit users) per admin.
# ADMIN_WRITE_THROTTLE_RATE=60/h

# Addresses allowed to set X-Forwarded-For (the Next.js server). Anyone else's
# header is ignored, so it can't be used to dodge the sign-in rate limit.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# --- Production (only read when DEBUG is off) ----------------------------------

# Redirect plain HTTP to HTTPS. Set False when Django is only reached over a
# private hop, e.g. the Next.js server calling http://127.0.0.1:8000 (the
# redirect would break that hop). The public HTTPS is then the frontend's job.
# SECURE_SSL_REDIRECT=True

# Behind a TLS-terminating proxy that sets X-Forwarded-Proto (and strips any
# client-sent one): lets Django know the request was HTTPS.
# TRUST_X_FORWARDED_PROTO=False

# HSTS, in seconds. Deliberately 0 (off) until HTTPS is confirmed working
# everywhere: browsers remember it, so it's hard to undo. Then e.g. 31536000,
# and consider including subdomains / preload.
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# Origins allowed to submit Django's own forms, i.e. /admin/ served over HTTPS
# on a public host. Comma-separated, e.g. https://admin.example.com
# CSRF_TRUSTED_ORIGINS=

# Email: console in development, SMTP otherwise (configure EMAIL_HOST etc.
# when email is first needed; the app sends none yet).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
