# Required. A long random value, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Local development only. Off (the default when unset) turns on the HTTPS
# hardening below and makes the seed commands refuse to run.
DEBUG=True

# Comma-separated; these are the defaults.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Optional (defaults shown) ------------------------------------------------

# Sign-in attempts allowed per username + client IP, e.g. 5/5m, 10/h.
# LOGIN_THROTTLE_RATE=5/5m

# Addresses allowed to set X-Forwarded-For (the Next.js server). Anyone else's
# header is ignored, so it can't be used to dodge the sign-in rate limit.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# --- Production (only read when DEBUG is off) ----------------------------------

# Redirect plain HTTP to HTTPS. Set False only if a proxy already does it.
# SECURE_SSL_REDIRECT=True

# HSTS, in seconds. Deliberately 0 (off) until HTTPS is confirmed working
# everywhere: browsers remember it, so it is hard to undo. Then e.g. 31536000.
# SECURE_HSTS_SECONDS=0

# Email: console in development, SMTP otherwise (configure EMAIL_HOST etc.
# when email is first needed; the app sends none yet).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
