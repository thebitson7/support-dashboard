# Server-side only: the Next.js API routes call Django here (the browser never does).
DJANGO_API_URL=http://127.0.0.1:8000/api

# Production, once HTTPS is confirmed working everywhere: send HSTS from this
# server (the one browsers talk to), in seconds. Hard to undo, so off by default.
# HSTS_MAX_AGE=31536000
